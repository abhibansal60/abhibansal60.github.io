---
import Base from '../layouts/Base.astro';
import resume from '../data/resume.json';
import { formatMonth } from '../lib';
---

<Base title="Work" description="Ten years at Morgan Stanley and Infosys, from test automation to agentic AI.">
  <div class="prose">
    <h1>Work</h1>
    <p class="lede">I started out writing test frameworks, moved into DevOps, and now lead agentic AI adoption at Morgan Stanley. The thread through all of it: build the harness that lets a team trust automation.</p>
  </div>

  <section aria-labelledby="built">
    <h2 id="built">What I built at Morgan Stanley</h2>
    <p class="muted prose">These are internal systems, so there are no screenshots or code here, only what they do.</p>
    <div class="grid">
      {resume.highlights.map((h) => (
        <article class="pane">
          <h3>{h.name}</h3>
          <p>{h.summary}</p>
        </article>
      ))}
    </div>
  </section>

  <section aria-labelledby="roles">
    <h2 id="roles">Roles</h2>
    <ol class="roles">
      {resume.work.map((w) => (
        <li>
          <p class="when">{formatMonth(w.startDate)} to {formatMonth(w.endDate)}</p>
          <div>
            <h3>{w.position}</h3>
            <p class="muted">{w.name}{w.location && `, ${w.location}`}</p>
            {w.summary && <p>{w.summary}</p>}
            <ul>{w.highlights.map((h) => <li>{h}</li>)}</ul>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section aria-labelledby="recognition" class="prose">
    <h2 id="recognition">Recognition and certifications</h2>
    <ul>
      {resume.awards.map((a) => <li>{a.title}, {a.awarder}. {a.summary}</li>)}
      {resume.certificates.map((c) => <li>{c.name}</li>)}
    </ul>
  </section>
</Base>

<style>
  section { margin-top: 4rem; }
  .lede { font-size: 1.25rem; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr)); gap: 1.5rem; margin-top: 1.5rem; }
  .grid .pane { padding-top: 1.25rem; }
  .grid p { margin: 0; }
  .roles { list-style: none; padding: 0; margin: 0; }
  .roles > li {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: 1.5rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .when { font: 0.9rem/1.6 var(--mono); color: var(--purple); margin: 0.2rem 0 0; }
  .roles h3 { margin-bottom: 0.2em; }
  .roles ul { padding-left: 1.1rem; margin: 0; max-width: var(--measure); }
  .roles ul li::marker { color: var(--green); }
  @media (max-width: 40rem) {
    .roles > li { grid-template-columns: 1fr; gap: 0.25rem; }
  }
</style>
