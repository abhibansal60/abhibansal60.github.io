---
import Base from '../layouts/Base.astro';
import resume from '../data/resume.json';
import Pipeline from '../components/Pipeline.astro';

---

<Base title="Work" description="Ten years at Morgan Stanley and Infosys, from test automation through modernization at scale to agentic AI.">
  <div class="prose">
    <h1>Work</h1>
    <p class="lede">Ten years from test automation to agentic AI, with five years of modernization at scale in between. The thread: build the harness that lets a team trust automation.</p>
  </div>


  <figure class="film first" id="film">
    <video controls preload="none" playsinline poster="/media/career-poster.jpg" width="1920" height="1080" aria-describedby="film-note">
      <source src="/media/career.mp4" type="video/mp4" />
    </video>
    <figcaption id="film-note" class="muted">Ten years in 40 seconds. The film is silent; the same timeline follows in text.</figcaption>
  </figure>

  <section aria-labelledby="run">
    <h2 id="run" class="sr-only">Career at a glance</h2>
    <Pipeline />
  </section>

  <section aria-labelledby="built">
    <h2 id="built">What I built at Morgan Stanley</h2>
    <p class="muted prose">These are internal systems, so there are no screenshots or code here, only what they do.</p>
    <div class="grid">
      {resume.highlights.map((h) => (
        <article class="pane">
          <h3>{h.url ? <a href={h.url}>{h.name}</a> : h.name}</h3>
          <p>{h.summary}</p>
        </article>
      ))}
    </div>
  </section>

  <p class="prose cv-link">Every role with dates and all its highlights is on the <a href="/cv/">CV</a>.</p>

</Base>

<style>
  section { margin-top: 4rem; }
  .cv-link { margin-top: 3rem; }
  .first { margin-top: 2.5rem; }
  .film { margin-inline: 0; margin-bottom: 0; }
  .film video { display: block; width: 100%; height: auto; background: var(--raised); border: 1px solid var(--line); }
  .film figcaption { margin-top: 0.6rem; font-size: 0.9rem; }
  .lede { font-size: 1.25rem; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr)); gap: 1.5rem; margin-top: 1.5rem; }
  .grid .pane { padding-top: 1.25rem; }
  .grid p { margin: 0; }
</style>
