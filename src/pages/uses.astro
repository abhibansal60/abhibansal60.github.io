---
import Base from '../layouts/Base.astro';

const setup = [
  ['Editor', 'VS Code, portable install, with Claude Code in the terminal next to it'],
  ['Prompt', 'Starship, two lines: directory, git status, runtimes, command duration'],
  ['Terminal', 'Ptyxis with a 16-colour matrix-green and cyber-purple palette, plus a Nerd Font'],
  ['Multiplexer', 'zellij, same palette'],
  ['CLI', 'eza, bat, fzf, zoxide, and git delta for side-by-side diffs'],
  ['Monitor', 'btop, themed'],
  ['Claude Code', 'A custom status line with context usage and rate-limit bars, plus the mattpocock-skills, ponytail, caveman and humanizer plugins'],
  ['Machines', 'Two HP EliteBooks that never sleep: an i7 with 30 GB as the main box, lid shut next to a monitor, and an i5 with 14 GB that I carry'],
  ['Agents', 'T3 Code on both laptops, reached from my iPhone over Tailscale, with two Claude Pro accounts as separate providers'],
  ['Voice', 'Handy with NVIDIA Parakeet, offline, one shortcut to dictate into any app'],
  ['Remote', 'GNOME remote desktop between the two laptops, one click from Remmina'],
];
---

<Base title="Uses" description="The Linux and Claude Code setup Abhinav Bansal works in every day.">
  <div class="prose">
    <h1>Uses</h1>
    <p class="lede">My daily setup on Ubuntu. All of it installs with one Claude Code skill, <a href="https://github.com/abhibansal60/ai-workbench">ai-workbench</a>. The tools need no sudo; the host settings hand me the few root commands to run.</p>
    <dl>
      {setup.map(([k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}
    </dl>
  </div>
</Base>

<style>
  .lede { font-size: 1.25rem; }
  dl { display: grid; grid-template-columns: 9rem 1fr; gap: 0.9rem 1.5rem; margin-top: 2.5rem; }
  dt { font-family: var(--mono); color: var(--muted); }
  dd { margin: 0; }
  @media (max-width: 40rem) { dl { grid-template-columns: 1fr; gap: 0.2rem; } dd { margin-bottom: 0.8rem; } }
</style>
