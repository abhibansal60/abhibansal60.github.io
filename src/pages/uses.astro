---
import Base from '../layouts/Base.astro';

const setup = [
  ['Editor', 'VS Code, portable install, with Claude Code in the terminal next to it'],
  ['Prompt', 'Starship, two lines: directory, git status, runtimes, command duration'],
  ['Terminal', 'Ptyxis with a 16-colour matrix-green and cyber-purple palette, plus a Nerd Font'],
  ['Multiplexer', 'zellij, same palette'],
  ['CLI', 'eza, bat, fzf, zoxide, and git delta for side-by-side diffs'],
  ['Monitor', 'btop, themed'],
  ['Claude Code', 'A custom status line with context usage and rate-limit bars, plus the mattpocock-skills, ponytail, caveman and humanizer plugins'],
];
---

<Base title="Uses" description="The Linux and Claude Code setup Abhinav Bansal works in every day.">
  <div class="prose">
    <h1>Uses</h1>
    <p class="lede">My daily setup on Ubuntu. All of it installs with one Claude Code skill, <a href="https://github.com/abhibansal60/ai-workbench">ai-workbench</a>, with no sudo. It's also where this site's colours come from.</p>
    <dl>
      {setup.map(([k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}
    </dl>
  </div>
</Base>

<style>
  .lede { font-size: 1.25rem; }
  dl { display: grid; grid-template-columns: 9rem 1fr; gap: 0.9rem 1.5rem; margin-top: 2.5rem; }
  dt { font-family: var(--mono); color: var(--purple); }
  dd { margin: 0; }
  @media (max-width: 40rem) { dl { grid-template-columns: 1fr; gap: 0.2rem; } dd { margin-bottom: 0.8rem; } }
</style>
