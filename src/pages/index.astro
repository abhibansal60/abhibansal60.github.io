---
import Base from '../layouts/Base.astro';
import resume from '../data/resume.json';
import { getPosts, formatDate } from '../lib';
import PipArt from '../components/PipArt.astro';
import Terminal from '../components/Terminal.astro';

const { basics, projects, leaks } = resume;
const role = `${resume.work[0].position}, ${resume.work[0].name}. ${basics.location.city}.`;
const linkedin = basics.profiles.find((p) => p.network === 'LinkedIn')!.url;
const github = basics.profiles.find((p) => p.network === 'GitHub')!.url;
const oneLine = (text: string) => text.split('. ')[0].replace(/\.$/, '') + '.';
const latest = (await getPosts())[0];
---

<Base>
  <section class="hero">
    <div class="portrait">
      <img src="/media/abhinav-london.jpg" width="640" height="640" alt="Abhinav Bansal by Tower Bridge in London" fetchpriority="high" />
      <PipArt width={80} />
    </div>
    <h1 data-pip-perch>{basics.label}</h1>
    <p class="subline">{basics.subline}</p>
    <p class="role">{role}</p>
    <ul class="button-row">
      <li><a class="button primary" href="/cv/">View CV</a></li>
      <li><a class="button" href={linkedin}>LinkedIn</a></li>
      <li><a class="button" href={github}>GitHub</a></li>
      <li><a class="button" href={`mailto:${basics.email}`}>Email me</a></li>
    </ul>
    <details class="console">
      <summary>Or ask Pip in the console</summary>
      <Terminal />
    </details>
  </section>

  <section class="figures" aria-label="In numbers">
    {resume.figures.map((f) => (
      <div>
        <p class:list={['value', { signal: f.signal }]}>{f.value}</p>
        <p class="label">{f.label}</p>
      </div>
    ))}
  </section>

  <section class="leaks" aria-labelledby="leaks-title">
    <h2 id="leaks-title">Leaks I fix</h2>
    <div class="leak-grid">
      {leaks.map((l) => (
        <article class="pane">
          <h3>{l.leak}</h3>
          <p>{l.fix}</p>
          <p class="proof"><span>Proof</span> <a href={l.url}>{l.proof}</a></p>
        </article>
      ))}
    </div>
  </section>

  <section class="featured" aria-label="Open source">
    <div class="pane">
      <span class="pane-title">open source</span>
      <ul class="project-list">
        {projects.filter((p) => p.featured).slice(0, 2).map((p) => (
          <li>
            <a href={p.url}>{p.name}</a> <span class="muted">{p.kind}</span>
            <p>{oneLine(p.description)}</p>
          </li>
        ))}
      </ul>
      <a href="/projects/">All projects</a>
    </div>
  </section>

  {latest && <section class="more" aria-label="Writing">
      <div class="pane">
        <span class="pane-title">writing</span>
        <h3><a href={`/writing/${latest.id}/`}>{latest.data.title}</a></h3>
        <p class="muted">{formatDate(latest.data.date)}</p>
      </div>
  </section>}
</Base>

<style>
  section { margin-bottom: 5rem; }
  h2 { font-size: clamp(1.8rem, 3.5vw, 2.6rem); }

  .hero { padding-top: 1rem; display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: 3rem; }
  .hero > :not(.portrait) { grid-column: 1; }
  .hero h1 { margin-bottom: 1.5rem; }
  /* Pip stands at the corner of the photo: the one drawn character next to the real person. */
  .portrait { grid-column: 2; grid-row: 1 / span 6; position: relative; width: clamp(12rem, 22vw, 17rem); margin-top: 0.5rem; align-self: start; }
  .portrait img { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; }
  .portrait :global(.pip-art) { position: absolute; left: -2.75rem; bottom: -1.25rem; width: 5rem; height: auto; }
  @media (max-width: 48rem) {
    .hero { grid-template-columns: 1fr; }
    .portrait { grid-column: 1; grid-row: auto; width: 7.5rem; margin: 0 0 1.5rem 2rem; }
    .portrait :global(.pip-art) { left: -2rem; bottom: -0.75rem; width: 3.25rem; }
  }
  .role { font-weight: 500; font-size: 1.05rem; margin-top: -0.25rem; }
  .console { margin-top: 1.5rem; max-width: 46rem; }
  .console summary { display: inline-block; cursor: pointer; color: var(--muted); text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: 0.2em; }
  .console summary:hover { color: var(--text); }
  .console[open] summary { margin-bottom: 0.75rem; }
  .subline { font-size: 1.25rem; max-width: 40ch; }
  .hero .button-row { margin-top: 1.75rem; }

  .figures { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.5rem; margin-bottom: 2.5rem; }
  .figures div { border-top: 3px solid var(--text); padding-top: 0.6rem; }
  .figures p { margin: 0; }
  .value { font: 800 clamp(2rem, 4.5vw, 3.2rem)/1 var(--display); letter-spacing: -0.035em; font-variant-numeric: tabular-nums; }
  .value.signal { color: var(--signal); }
  .label { color: var(--muted); font-size: 0.95rem; margin-top: 0.4rem !important; }


  .leak-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem 1.5rem; margin-top: 1.5rem; }
  .leak-grid h3 { font-size: 1.5rem; }
  .proof { margin: 0; font-size: 0.95rem; }
  .proof span { display: block; color: var(--signal); font-weight: 500; font-size: 0.85rem; }
  .proof a { text-decoration-color: var(--line); }

  .featured { max-width: 46rem; }
  .project-list { list-style: none; margin: 0 0 1rem; padding: 0; display: grid; gap: 0.9rem; }
  .project-list a { font-weight: 800; font-size: 1.15rem; }
  .project-list p { margin: 0.15rem 0 0; font-size: 0.95rem; }
  .pane > :last-child { margin-bottom: 0; }


  .more { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem 1.5rem; }
  .more h3 { font-size: 1.2rem; }
  .more h3 a { text-decoration: none; }

  @media (max-width: 60rem) {
    .figures { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .leak-grid, .more { grid-template-columns: 1fr; }
  }
</style>
