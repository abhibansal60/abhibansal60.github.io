---
import Base from '../layouts/Base.astro';
import resume from '../data/resume.json';
import { getPosts, formatDate } from '../lib';
import Terminal from '../components/Terminal.astro';
import { getLiveStats } from '../stats';

const { basics, projects, talks } = resume;
const linkedin = basics.profiles.find((p) => p.network === 'LinkedIn')!.url;
const github = basics.profiles.find((p) => p.network === 'GitHub')!.url;
const [lead, ...others] = projects.filter((p) => p.featured);
const latest = (await getPosts())[0];
const live = await getLiveStats();
const builtOn = live.builtAt.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/London' });
const patent = resume.highlights.find((h) => h.name.startsWith('BLAZE'))!;

---

<Base>
  <section class="hero">
    <div class="intro">
      <h1 data-pip-perch>{basics.label}</h1>
      <p class="subline">{basics.subline}</p>
      <p class="muted">Vice President at Morgan Stanley, leading engineering teams. Based in Glasgow.</p>
      <ul class="button-row">
        <li><a class="button primary" href="/cv/">View CV</a></li>
        <li><a class="button" href={linkedin}>LinkedIn</a></li>
        <li><a class="button" href={github}>GitHub</a></li>
        <li><a class="button" href={`mailto:${basics.email}`}>Email me</a></li>
      </ul>
    </div>

    <Terminal />
  </section>

  <section class="figures" aria-label="In numbers">
    {resume.figures.map((f) => (
      <div>
        <p class:list={['value', { signal: f.signal }]}>{f.value}</p>
        <p class="label">{f.label}</p>
      </div>
    ))}
  </section>

  {live.stats.length > 0 && (
    <section class="live" aria-labelledby="live-title">
      <h2 id="live-title">Live from GitHub and PyPI</h2>
      <dl>
        {live.stats.map((s) => (
          <div><dt>{s.label}</dt><dd>{s.value}</dd></div>
        ))}
      </dl>
      <p class="muted">Rebuilt every night. Last updated <time datetime={live.builtAt.toISOString()}>{builtOn}</time>.</p>
    </section>
  )}

  <section class="panes" aria-label="Highlights">
    <div class="pane now">
      <span class="pane-title">now</span>
      <p>{basics.currently}</p>
    </div>

    <article class="pane focused lead">
      <span class="pane-title">{lead.kind}</span>
      <h2><a href={lead.url}>{lead.name}</a></h2>
      <p>{lead.description}</p>
      <ul class="facts">{lead.highlights!.map((h) => <li>{h}</li>)}</ul>
      <pre><code>{lead.install}</code></pre>
    </article>

    {others.map((p) => (
      <article class="pane">
        <span class="pane-title">{p.kind}</span>
        <h3><a href={p.url}>{p.name}</a></h3>
        <p>{p.description}</p>
        <ul class="tags">{p.keywords.map((k) => <li>{k}</li>)}</ul>
      </article>
    ))}

    <div class="pane">
      <span class="pane-title">us patent</span>
      <h3><a href={patent.url}>{patent.name}</a></h3>
      <p>{patent.summary}</p>
      <a href="/work/">How I got from test automation to agents</a>
    </div>

    <div class="pane">
      <span class="pane-title">writing</span>
      {latest ? (
        <>
          <h3><a href={`/writing/${latest.id}/`}>{latest.data.title}</a></h3>
          <p class="muted">{formatDate(latest.data.date)}</p>
          <a href="/writing/">All writing</a>
        </>
      ) : (
        <p>First posts are on the way. Follow along with <a href="/rss.xml">RSS</a>.</p>
      )}
    </div>

    <div class="pane speaking">
      <span class="pane-title">speaking</span>
      <h3>{talks[0].title}</h3>
      <p>{talks[0].summary}</p>
      <a href="/speaking/">All talk topics</a>
    </div>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 3rem;
    align-items: center;
    margin-bottom: 5rem;
  }
  .intro h1 { max-width: 14ch; }
  .subline { font-size: 1.25rem; max-width: 40ch; }
  .intro .button-row { margin-top: 1.75rem; }

  .figures { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.5rem; margin-bottom: 2.5rem; }

  .live { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 3fr); gap: 0.5rem 1.5rem; margin-bottom: 5rem; align-items: baseline; }
  .live h2 { font-size: 1rem; font-weight: 500; letter-spacing: 0; margin: 0; }
  .live dl { display: flex; flex-wrap: wrap; gap: 0.5rem 2rem; margin: 0; }
  .live dl div { display: flex; flex-direction: column-reverse; }
  .live dt { color: var(--muted); font-size: 0.9rem; }
  .live dd { margin: 0; font-weight: 800; font-size: 1.4rem; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
  .live p { grid-column: 2; margin: 0; font-size: 0.85rem; }
  .figures div { border-top: 3px solid var(--text); padding-top: 0.6rem; }
  .figures p { margin: 0; }
  .value { font: 800 clamp(2rem, 4.5vw, 3.2rem)/1 var(--display); letter-spacing: -0.035em; font-variant-numeric: tabular-nums; }
  .value.signal { color: var(--signal); }
  .label { color: var(--muted); font-size: 0.95rem; margin-top: 0.4rem !important; }


  .panes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem 1.5rem;
  }
  .now { grid-column: 1 / -1; font-size: 1.15rem; }
  .speaking { grid-column: 1 / -1; }
  .speaking p { max-width: var(--measure); }
  .now p { margin: 0; }
  .lead { grid-row: span 2; }
  .lead h2 a, .pane h3 a { text-decoration: none; }
  .facts { padding-left: 1.1rem; }
  .facts li::marker { color: var(--signal); }
  .pane > :last-child { margin-bottom: 0; }

  @media (max-width: 60rem) {
    .live { grid-template-columns: 1fr; }
    .live p { grid-column: 1; }
    .figures { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .hero { grid-template-columns: 1fr; gap: 2.5rem; }
    .panes { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 40rem) {
    .panes { grid-template-columns: 1fr; }
    .lead { grid-row: auto; }
  }
</style>
