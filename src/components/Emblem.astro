---
// A project's emblem on a schematic plate: dot grid, crop marks, flat ink linework in Pip's style
// and one red "lamp". A scan line sweeps the plate when its card is hovered or focused.
interface Props { name: string }
const { name } = Astro.props;
---

<svg class="emblem" viewBox="0 0 120 80" aria-hidden="true">
  <path class="crop" d="M4 12V4h8M108 4h8v8M116 68v8h-8M12 76H4v-8" />
  {name === 'tidy' && (
    <g>
      <rect class="ink faint" x="34" y="16" width="56" height="36" rx="2" />
      <rect class="ink" x="28" y="24" width="56" height="36" rx="2" />
      <path class="line" d="M28 26l28 20 28-20" />
      <circle class="lamp" cx="86" cy="24" r="9" />
      <path class="mark" d="M81.5 24l3 3 6-6" />
    </g>
  )}
  {name === 'iphone-backup-linux' && (
    <g>
      <rect class="ink" x="20" y="12" width="24" height="44" rx="4" />
      <rect class="screen" x="24" y="18" width="16" height="30" />
      <path class="line" d="M29 52h6" />
      <path class="line" d="M32 56c0 16 26 14 40-10" />
      <rect class="ink" x="72" y="34" width="32" height="22" rx="3" />
      <path class="line" d="M72 40h32" />
      <rect class="lamp" x="94" y="48" width="6" height="3" />
    </g>
  )}
  {name === 'ai-workbench' && (
    <g>
      <rect class="ink" x="16" y="12" width="88" height="56" rx="4" />
      <path class="line" d="M16 22h88" />
      <path class="line" d="M26 34l8 6-8 6" />
      <rect class="lamp" x="40" y="44" width="12" height="4" />
      <path class="line faint" d="M60 34h32M60 42h24M60 50h28" />
    </g>
  )}
  {name === 'awesome-copilot-toolkit' && (
    <g>
      <rect class="ink" x="16" y="46" width="88" height="20" rx="2" />
      <rect class="ink" x="26" y="26" width="18" height="24" rx="1" />
      <rect class="ink" x="51" y="26" width="18" height="24" rx="1" />
      <rect class="ink" x="76" y="12" width="18" height="24" rx="1" />
      <rect class="lamp" x="76" y="12" width="18" height="5" />
    </g>
  )}
  {name === 'macify' && (
    <g>
      <rect class="ink" x="12" y="14" width="68" height="48" rx="6" />
      <path class="line" d="M12 26h68" />
      <circle class="lamp" cx="21" cy="20" r="2.6" />
      <circle class="dot" cx="29" cy="20" r="2.6" />
      <circle class="dot" cx="37" cy="20" r="2.6" />
      <g transform="translate(196 0) scale(-1 1)">
        <path class="line" d="M106 38a12 12 0 1 0 2 12" />
        <path class="line" d="M107 30v8h-8" />
      </g>
    </g>
  )}
  {name === 'explore-mullana' && (
    <g>
      <path class="ink" d="M14 20l30-8 32 8 30-8v48l-30 8-32-8-30 8z" />
      <path class="line faint" d="M44 12v48M76 20v48" />
      <circle class="lamp" cx="60" cy="36" r="6" />
      <path class="line" d="M60 42v8" />
    </g>
  )}
  {!['tidy', 'iphone-backup-linux', 'ai-workbench', 'awesome-copilot-toolkit', 'macify', 'explore-mullana'].includes(name) && (
    <g>
      <circle class="ink" cx="60" cy="40" r="20" />
      <path class="line" d="M60 14v6M60 60v6M34 40h6M80 40h6" />
      <circle class="lamp" cx="60" cy="40" r="5" />
    </g>
  )}
  <rect class="scan" x="4" y="0" width="112" height="2" />
</svg>

<style>
  .emblem { display: block; width: 100%; height: auto; overflow: visible; }
  .crop { fill: none; stroke: var(--muted); stroke-width: 1; }
  .ink { fill: var(--bg); stroke: var(--text); stroke-width: 2.5; stroke-linejoin: round; }
  .line { fill: none; stroke: var(--text); stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
  .faint { stroke: var(--muted); stroke-width: 2; }
  .screen { fill: var(--text); }
  .dot { fill: var(--text); }
  .lamp { fill: var(--signal); }
  .mark { fill: none; stroke: #fff; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
  .scan { fill: var(--signal); opacity: 0; transform-box: view-box; }
</style>
