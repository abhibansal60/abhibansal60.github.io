---
import resume from '../data/resume.json';

// The career as a CI run log: every stage and its steps are visible, oldest first, on a status rail.
// Renders fully passed without JS; the script replays the run once when scrolled into view.
const stages = [
  ...resume.timeline.map((t) => ({ stage: t.stage, name: t.name, year: t.year, log: t.log })),
  { stage: 'next', name: 'In progress', year: 'now', log: ['Building agents that ship safely inside a regulated enterprise', 'Writing up what works, every two weeks'] },
];
const last = stages.length - 1;
---

<div class="pipe" data-pipeline>
  <div class="pipe-head">
    <p class="file">career.yml</p>
    <p class="status" data-status>{last} of {stages.length} stages passed, 1 running</p>
  </div>

  <ol class="jobs">
    {stages.map((s, i) => (
      <li class:list={['job', i === last ? 'run' : 'done']} data-job>
        <p class="meta"><span class="yr">{s.year}</span><span class="stg">{s.stage}</span></p>
        <span class="node" aria-hidden="true"></span>
        <div class="body">
          <h3>{s.name} <span class="state" data-state>{i === last ? 'running' : 'passed'}</span></h3>
          <ul>{s.log.map((l) => <li>{l}</li>)}</ul>
        </div>
      </li>
    ))}
  </ol>

  <button type="button" class="replay" data-replay hidden>Re-run pipeline</button>
</div>

<style>
  .pipe {
    background: var(--raised);
    border: 1px solid var(--line);
    padding: clamp(1rem, 4vw, 1.75rem);
  }
  .pipe-head {
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline;
    gap: 0.25rem 1rem; padding-bottom: 1rem; margin-bottom: 1.5rem; border-bottom: 1px solid var(--line);
  }
  .pipe-head p { margin: 0; }
  .file { font: 600 1.3rem var(--display); }
  .status { font: 0.8rem var(--mono); color: var(--muted); }

  /* Mobile first: rail on the left, year and stage folded above each title. */
  .jobs { list-style: none; margin: 0; padding: 0; }
  .job {
    --rail: var(--line);
    position: relative; display: grid; grid-template-columns: 1.25rem minmax(0, 1fr);
    column-gap: 0.9rem; padding-bottom: 1.75rem;
  }
  .job:last-child { padding-bottom: 0; }
  /* The rail runs from this node down to the next one. */
  .job:not(:last-child)::before {
    content: ''; position: absolute; left: calc(0.625rem - 1px); top: 1.1rem; bottom: -0.35rem;
    width: 2px; background: var(--rail); transition: background 0.3s;
  }
  .job.done { --rail: color-mix(in srgb, var(--cyan) 55%, transparent); }
  .meta { grid-column: 2; margin: 0 0 0.15rem; font: 0.78rem var(--mono); color: var(--muted); display: flex; gap: 0.6rem; }
  .stg { color: var(--cyan); text-transform: uppercase; letter-spacing: 0.06em; }
  .node {
    grid-column: 1; grid-row: 1 / span 2; justify-self: center; margin-top: 0.2rem;
    width: 1rem; height: 1rem; border-radius: 50%; border: 2px solid var(--line); background: var(--raised);
    position: relative; z-index: 1; transition: background 0.3s, border-color 0.3s;
  }
  .done .node { border-color: var(--cyan); background: var(--cyan); }
  .done .node::after {
    content: ''; position: absolute; left: 4px; top: 1px; width: 3px; height: 7px;
    border: solid var(--bg); border-width: 0 2px 2px 0; transform: rotate(45deg);
  }
  .run .node { border-color: var(--red); border-top-color: transparent; animation: spin 0.9s linear infinite; }
  .body { grid-column: 2; min-width: 0; }
  h3 {
    font: 600 1.2rem/1.25 var(--display); margin: 0 0 0.4rem;
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.2rem 0.6rem;
  }
  .state { font: 500 0.72rem var(--mono); letter-spacing: 0.02em; color: var(--muted); }
  .done .state { color: var(--cyan); }
  .run .state { color: var(--red); }
  .body ul { margin: 0; padding: 0; list-style: none; max-width: 62ch; }
  .body li { position: relative; padding-left: 1.1rem; font-size: 0.97rem; line-height: 1.5; color: var(--text); }
  .body li + li { margin-top: 0.3rem; }
  .body li::before {
    content: ''; position: absolute; left: 0.1rem; top: 0.62em; width: 0.4rem; height: 2px; background: var(--muted);
  }
  .queued { opacity: 0.45; }
  .queued .node { border-color: var(--line); background: var(--raised); animation: none; }
  .queued .node::after { display: none; }
  .queued .state { color: var(--muted); }

  .replay {
    display: block; margin: 1.5rem 0 0 auto; min-height: 2.5rem;
    font: 500 0.8rem var(--mono); color: var(--muted); background: transparent;
    border: 1px solid var(--line); padding: 0.4rem 0.8rem; cursor: pointer;
  }
  .replay[hidden] { display: none; }
  .replay:hover { color: var(--cyan); border-color: var(--cyan); }

  /* Wider screens: year and stage move into their own column left of the rail. */
  @media (min-width: 40rem) {
    .job { grid-template-columns: 6.5rem 1.25rem minmax(0, 1fr); column-gap: 1.1rem; }
    .job:not(:last-child)::before { left: calc(6.5rem + 1.1rem + 0.625rem - 1px); }
    .meta { grid-column: 1; grid-row: 1; flex-direction: column; align-items: flex-end; gap: 0.1rem; margin: 0.15rem 0 0; text-align: right; }
    .yr { font-size: 0.95rem; color: var(--text); }
    .node { grid-column: 2; grid-row: 1; }
    .body { grid-column: 3; grid-row: 1; }
  }

  @keyframes spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) {
    .run .node { animation: none; border-top-color: var(--red); border-style: dashed; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-pipeline]');
  if (root) {
    const jobs = [...root.querySelectorAll<HTMLElement>('[data-job]')];
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const replay = root.querySelector<HTMLButtonElement>('[data-replay]')!;
    const last = jobs.length - 1;
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

    const set = (job: HTMLElement, state: 'queued' | 'run' | 'done', label: string) => {
      job.classList.remove('queued', 'run', 'done');
      job.classList.add(state);
      job.querySelector('[data-state]')!.textContent = label;
    };

    let runId = 0;
    async function run() {
      const id = ++runId;
      jobs.forEach((j) => set(j, 'queued', 'queued'));
      status.textContent = 'running';
      for (let i = 0; i < jobs.length; i++) {
        if (id !== runId) return;
        set(jobs[i], 'run', 'running');
        if (i === last) break;
        await sleep(450);
        if (id !== runId) return;
        set(jobs[i], 'done', 'passed');
      }
      status.textContent = `${last} of ${jobs.length} stages passed, 1 running`;
    }

    replay.hidden = false;
    replay.addEventListener('click', run);
    if (!still) {
      const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) { io.disconnect(); run(); } }, { threshold: 0.25 });
      io.observe(root);
    }
  }
</script>
