---
// Pip, the site's plumber droid. Floats in the corner, says one line when clicked, and can be sent home.
// Decorative: it never speaks unprompted, stays still under reduced motion and never prints.
const quips = [
  'Pip here. No leaks on this page.',
  'Checked the pipes. Pipeline is green.',
  'Every fix ships with a tool, so it stays fixed.',
  'On the home page, type plumber in the terminal.',
  'The terminal has a crawl command. Bring popcorn.',
  'Agents: /llms.txt is yours.',
];
---

<div class="pip" data-pip hidden>
  <div class="bubble" data-bubble role="status" aria-live="polite" hidden>
    <p data-say></p>
    <button type="button" class="dismiss" data-dismiss>Send Pip home</button>
  </div>
  <button type="button" class="droid" data-droid aria-label="Pip, the plumber droid. Click for a tip.">
    <svg viewBox="0 0 64 72" width="56" height="63" aria-hidden="true">
      <ellipse class="jet" cx="32" cy="66" rx="7" ry="3" />
      <line class="antenna" x1="32" y1="12" x2="32" y2="5" />
      <circle class="tip" cx="32" cy="4" r="2.2" />
      <path class="dome" d="M15 30a17 17 0 0 1 34 0z" />
      <rect class="visor" x="22" y="19" width="20" height="7" rx="3.5" />
      <g class="eye"><circle cx="32" cy="22.5" r="2.6" /></g>
      <rect class="body" x="15" y="30" width="34" height="28" rx="6" />
      <rect class="band" x="15" y="38" width="34" height="4" />
      <circle class="bolt" cx="22" cy="50" r="1.6" />
      <circle class="bolt" cx="42" cy="50" r="1.6" />
      <g class="arm">
        <path d="M49 44h4" />
        <g class="wrench" transform="rotate(-40 53 44)">
          <rect x="52" y="42.9" width="8" height="2.2" rx="1.1" />
          <circle cx="61.5" cy="44" r="3.3" />
          <rect class="jaw" x="61" y="43" width="4.5" height="2" />
        </g>
      </g>
    </svg>
  </button>
  <script type="application/json" data-quips set:html={JSON.stringify(quips)} />
</div>

<style>
  .pip {
    position: fixed; right: clamp(0.75rem, 2vw, 1.5rem); bottom: clamp(0.75rem, 2vw, 1.5rem); z-index: 5;
    display: flex; flex-direction: column; align-items: flex-end; gap: 0.4rem; pointer-events: none;
  }
  .pip[hidden], .bubble[hidden] { display: none; }
  .pip > * { pointer-events: auto; }

  .droid {
    padding: 0; border: 0; background: none; cursor: pointer; line-height: 0; opacity: 0.85;
    animation: float 6s ease-in-out infinite; transition: opacity 0.2s;
  }
  .droid:hover, .droid:focus-visible { opacity: 1; }
  .droid:focus-visible { outline-offset: 2px; border-radius: 50%; }

  svg { overflow: visible; }
  .dome { fill: var(--muted); }
  .visor { fill: var(--bg); }
  .eye circle { fill: var(--holo); filter: drop-shadow(0 0 3px var(--holo)); }
  .eye { transform-origin: 32px 22.5px; animation: blink 7s infinite; }
  .body { fill: var(--raised); stroke: var(--muted); stroke-width: 1.5; }
  .band { fill: var(--green); opacity: 0.8; }
  .bolt { fill: var(--muted); }
  .antenna { stroke: var(--muted); stroke-width: 1.5; }
  .tip { fill: var(--amber); animation: pulse 2.4s ease-in-out infinite; }
  .arm path { fill: none; stroke: var(--muted); stroke-width: 2; stroke-linecap: round; }
  .wrench { fill: var(--amber); }
  .wrench .jaw { fill: var(--bg); }
  .arm { transform-origin: 49px 44px; transition: transform 0.3s; }
  .droid:hover .arm, .droid.talking .arm { transform: rotate(-18deg); }
  .jet { fill: var(--holo); opacity: 0.35; animation: jet 1.2s ease-in-out infinite; transform-origin: 32px 66px; }

  .bubble {
    max-width: min(16rem, calc(100vw - 2rem)); padding: 0.6rem 0.8rem; margin-right: 0.5rem;
    background: var(--raised); border: 1px solid var(--line); border-radius: 8px;
    font: 0.82rem/1.45 var(--mono); color: var(--text); box-shadow: 0 6px 24px rgb(0 0 0 / 0.35);
  }
  .bubble p { margin: 0 0 0.4rem; }
  .dismiss {
    padding: 0; border: 0; background: none; cursor: pointer; font: inherit; font-size: 0.75rem;
    color: var(--muted); text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: 0.2em;
  }
  .dismiss:hover { color: var(--green); }

  @keyframes float { 50% { transform: translateY(-6px); } }
  @keyframes blink { 0%, 95%, 100% { transform: scaleY(1); } 97% { transform: scaleY(0.1); } }
  @keyframes pulse { 50% { opacity: 0.35; } }
  @keyframes jet { 50% { transform: scaleX(0.7); opacity: 0.2; } }

  @media (max-width: 40rem) {
    .droid svg { width: 42px; height: 47px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .droid, .eye, .tip, .jet { animation: none; }
  }
  @media print {
    .pip { display: none; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-pip]');
  const KEY = 'pip-home';
  const read = () => { try { return localStorage.getItem(KEY); } catch { return null; } };
  const write = (v: string) => { try { localStorage.setItem(KEY, v); } catch {} };

  if (root) {
    const droid = root.querySelector<HTMLButtonElement>('[data-droid]')!;
    const bubble = root.querySelector<HTMLElement>('[data-bubble]')!;
    const say = root.querySelector<HTMLElement>('[data-say]')!;
    const quips: string[] = JSON.parse(root.querySelector('[data-quips]')!.textContent!);
    let i = 0, timer = 0;

    const hide = () => { bubble.hidden = true; droid.classList.remove('talking'); };
    droid.addEventListener('click', () => {
      clearTimeout(timer);
      if (!bubble.hidden) return hide();
      say.textContent = quips[i++ % quips.length];
      bubble.hidden = false;
      droid.classList.add('talking');
      timer = window.setTimeout(hide, 6000);
    });
    root.querySelector('[data-dismiss]')!.addEventListener('click', () => {
      write('1');
      hide();
      root.hidden = true;
    });
    addEventListener('keydown', (e) => { if (e.key === 'Escape' && !bubble.hidden) hide(); });
    // The terminal's pip command brings Pip back.
    addEventListener('pip:summon', () => { write('0'); root.hidden = false; });
    root.hidden = read() === '1';
  }
</script>
