---
// Pip on the home page: tap a question, Pip answers from resume.json.
// Each question is a native <details> in one named group, so only one is open at a time,
// and it all works without JavaScript. The last option opens the console.
import PipArt from './PipArt.astro';
import Terminal from './Terminal.astro';
import resume from '../data/resume.json';
import { getLiveStats } from '../stats';

const { basics, leaks, figures, projects } = resume;
const patent = resume.highlights.find((h) => h.url?.includes('patents.google'))!;
const linkedin = basics.profiles.find((p) => p.network === 'LinkedIn')!.url;
const github = basics.profiles.find((p) => p.network === 'GitHub')!.url;
const commits = (await getLiveStats()).stats.find((s) => s.label.startsWith('Public commits'));
---

<div class="greeter">
  <PipArt width={120} />
  <div class="talk">
    <p class="hello">Hi, I'm Pip, the site's plumber droid. Ask me something.</p>

    <details name="pip">
      <summary>What does Abhinav fix?</summary>
      <div class="answer">
        <p>Engineering leaks, then the tools that keep them fixed:</p>
        <ul>{leaks.map((l) => <li><strong>{l.leak}.</strong> {l.fix}</li>)}</ul>
      </div>
    </details>

    <details name="pip">
      <summary>Show me proof</summary>
      <div class="answer">
        <ul>
          {figures.map((f) => <li><strong>{f.value}</strong> {f.label[0].toLowerCase() + f.label.slice(1)}</li>)}
          <li><a href={patent.url}>{patent.patent}</a>, granted June 2025</li>
        </ul>
        <p><a href="/work/">Full timeline on the work page</a></p>
      </div>
    </details>

    <details name="pip">
      <summary>What's Abhinav building now?</summary>
      <div class="answer">
        <p>{basics.currently}</p>
        <p>
          On the side: {projects.filter((p) => p.featured).map((p, i, all) => (
            <><a href={p.url}>{p.name}</a>{i < all.length - 2 ? ', ' : i === all.length - 2 ? ' and ' : ''}</>
          ))}{commits && <>, with {commits.value} public commits this year</>}.
        </p>
        <p>Next for this site: an AI agent and a public MCP server that answer questions about the work.</p>
      </div>
    </details>

    <details name="pip">
      <summary>How do I reach Abhinav?</summary>
      <div class="answer">
        <ul>
          <li>Email: <a href={`mailto:${basics.email}`}>{basics.email}</a></li>
          <li><a href={linkedin}>LinkedIn</a> and <a href={github}>GitHub</a></li>
          <li>Or read the <a href="/cv/">CV</a> first</li>
        </ul>
      </div>
    </details>

    <details name="pip" class="console">
      <summary>Open the console</summary>
      <div class="answer bare"><Terminal /></div>
    </details>
  </div>
</div>

<style>
  .greeter { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 1.25rem; align-items: start; }
  .greeter :global(.pip-art) { margin-top: 0.25rem; }
  .talk { display: grid; gap: 0.5rem; }
  .hello { margin: 0 0 0.25rem; padding: 0.7rem 1rem; background: var(--raised); border-top: 3px solid var(--signal); }

  summary {
    display: inline-block; cursor: pointer; list-style: none; padding: 0.45rem 0.85rem;
    border: 2px solid var(--text); font-weight: 500;
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover, details[open] > summary { background: var(--text); color: var(--bg); }
  .answer { margin-top: 0.5rem; padding: 0.8rem 1rem; background: var(--raised); font-size: 0.95rem; line-height: 1.5; }
  .answer.bare { padding: 0; background: none; }
  .answer p { margin: 0 0 0.6rem; }
  .answer > :last-child { margin-bottom: 0; }
  .answer ul { margin: 0 0 0.6rem; padding-left: 1.1rem; display: grid; gap: 0.35rem; }
  .answer li::marker { color: var(--signal); }
  details[open] .answer { animation: open 0.2s ease-out; }
  @keyframes open { from { opacity: 0; transform: translateY(-4px); } }

  @media (max-width: 30rem) {
    .greeter { grid-template-columns: 1fr; }
    .greeter :global(.pip-art) { width: 84px; height: auto; }
  }
</style>
