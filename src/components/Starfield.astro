---
// A slow-drifting starfield behind every page, dark theme only. Decorative.
---

<canvas class="stars" data-stars aria-hidden="true"></canvas>

<style>
  .stars { position: fixed; inset: 0; width: 100%; height: 100%; z-index: -1; pointer-events: none; }
  @media (prefers-color-scheme: light) {
    .stars { display: none; }
  }
</style>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-stars]');
  const dark = matchMedia('(prefers-color-scheme: dark)');
  if (canvas) {
    const ctx = canvas.getContext('2d')!;
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    type Star = { x: number; y: number; z: number; tw: number };
    let stars: Star[] = [], w = 0, h = 0, raf = 0, last = 0;

    function reset() {
      const dpr = devicePixelRatio || 1;
      w = innerWidth; h = innerHeight;
      canvas!.width = w * dpr; canvas!.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      // z is depth: near stars are bigger, brighter and drift faster.
      stars = Array.from({ length: Math.round((w * h) / 3500) }, () => ({ x: Math.random() * w, y: Math.random() * h, z: Math.random() ** 2, tw: Math.random() * 6.3 }));
      draw(0);
    }
    function draw(t: number) {
      ctx.clearRect(0, 0, w, h);
      for (const s of stars) {
        const a = 0.25 + s.z * 0.65 + Math.sin(t / 900 + s.tw) * 0.12;
        ctx.fillStyle = s.z > 0.85 ? `rgba(125,216,255,${a})` : `rgba(232,236,245,${a})`;
        const r = 0.4 + s.z * 1.1;
        ctx.fillRect(s.x, s.y, r, r);
      }
    }
    function frame(t: number) {
      const dt = Math.min(t - last, 50); last = t;
      for (const s of stars) {
        s.x -= (0.004 + s.z * 0.02) * dt;
        if (s.x < 0) { s.x = w; s.y = Math.random() * h; }
      }
      draw(t);
      raf = requestAnimationFrame(frame);
    }
    const start = () => { if (!still && dark.matches && !document.hidden && !raf) { last = performance.now(); raf = requestAnimationFrame(frame); } };
    const stop = () => { cancelAnimationFrame(raf); raf = 0; };

    reset();
    start();
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    dark.addEventListener('change', () => (dark.matches ? (reset(), start()) : stop()));
    let lastWidth = innerWidth, timer = 0;
    addEventListener('resize', () => {
      if (innerWidth === lastWidth) return;
      lastWidth = innerWidth;
      clearTimeout(timer);
      timer = window.setTimeout(reset, 200);
    });
  }
</script>
