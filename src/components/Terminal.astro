---
import resume from '../data/resume.json';
import { getPosts } from '../lib';

// Every command's output is built here at build time, so the browser only looks strings up.
const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
const dim = (s: string) => `<span class="d">${esc(s)}</span>`;
const link = (href: string, text: string) => `<a href="${esc(href)}">${esc(text)}</a>`;

const { basics, projects, timeline, talks } = resume;
const posts = await getPosts();
const linkedin = basics.profiles.find((p) => p.network === 'LinkedIn')!.url;
const pad = Math.max(...projects.map((p) => p.name.length)) + 3;

const commands: Record<string, string> = {
  whoami: `${esc(basics.name)}, ${esc(basics.location.city)}.\n${esc(basics.label)}\n${dim('VP at Morgan Stanley, leading engineering teams. 10 years from test automation to agentic AI.')}
${dim('try: plumber')}`,
  projects: projects
    .map((p) => `<span class="g">${esc(p.name)}/</span>${' '.repeat(pad - p.name.length - 1)}${esc(p.kind)}`)
    .join('\n') + `\n${dim('type a project name for details')}`,
  experience: [...timeline].reverse().map((t) => `<span class="p">${t.year}</span>  ${esc(t.name)}: ${esc(t.log[0])}`).join('\n') + `\n${dim('full history: ')}${link('/work/', '/work')}`,
  patent: `BLAZE: BDD Lean Automation Zenith Engine\nAPI specifications in, executable Java test suites out.\n${dim('US patent, co-inventor.')}`,
  writing: posts.length
    ? posts.slice(0, 5).map((p) => link(`/writing/${p.id}/`, p.data.title)).join('\n')
    : `First posts are on the way. ${link('/rss.xml', 'RSS')}`,
  speaking: talks.map((t) => `<span class="g">*</span> ${esc(t.title)}`).join('\n') + `\n${dim('more: ')}${link('/speaking/', '/speaking')}`,
  contact: `${link(`mailto:${basics.email}`, basics.email)}\n${link(linkedin, linkedin.replace('https://www.', ''))}`,
  plumber: [
    `Wherever there's a leak, I go in.`,
    `<span class="g">✓</span> Five years modernizing tech at scale across a global bank`,
    `<span class="g">✓</span> Cookie-cutter tools, so every team starts from a pattern that works`,
    `<span class="g">✓</span> Then I get on stage and show people how to use them`,
    dim('no job too small, no pipeline too clogged'),
  ].join('\n'),
  pip: `<span class="g">Pip is back on duty.</span> ${dim('bottom right, holding a wrench')}`,
  cv: `opening ${link('/cv/', '/cv')} ...`,
  crawl: dim('rolling the opening crawl. Press Esc to skip.'),
  'sudo rm -rf /': `<span class="g">[harness] blocked.</span>\nThe model can ask. Plain code decides. That's the whole idea.`,
};
for (const p of projects) {
  commands[p.name] = [
    `<span class="d">→ show_project("${esc(p.name)}")</span>`,
    esc(p.description),
    ...(p.highlights ?? []).map((h) => `<span class="g">✓</span> ${esc(h)}`),
    ...(p.install ? [`<span class="g">${esc(p.install)}</span>`] : []),
    link(p.url, p.url.replace('https://', '')),
  ].join('\n');
}
const chips = ['whoami', 'plumber', 'projects', 'experience', 'patent', 'writing', 'contact', 'sudo rm -rf /', 'clear'];
commands.help = dim(`commands: ${[...chips, 'speaking', 'cv', 'crawl', 'pip', ...projects.map((p) => p.name)].join(', ')}`);
---

<div class="term" data-term>
  <div class="bar"><span>Detail A: console</span><span>abhinav@portfolio: ~</span></div>
  <div class="out" data-out aria-live="polite">
    <p><span class="p">$ </span>whoami</p>
    <p class="r" set:html={commands.whoami} />
    <p><span class="p">$ </span>projects</p>
    <p class="r" set:html={commands.projects} />
  </div>
  <form class="in" data-form autocomplete="off" hidden>
    <span class="p" aria-hidden="true">$</span>
    <input data-input aria-label="Type a command" placeholder="type help, or tap a command below" spellcheck="false" autocapitalize="off" />
  </form>
  <div class="chips" data-chips hidden>
    {chips.map((c) => <button type="button" data-cmd={c}>{c}</button>)}
  </div>
  <dialog class="crawl" data-crawl aria-label="Career opening crawl">
    <button type="button" class="skip-crawl" data-close>Skip</button>
    <p class="crawl-intro">A long time ago, in a bank far, far away....</p>
    <div class="crawl-stage">
      <div class="crawl-text">
        <p class="ep">Episode X</p>
        <p class="ep-title">The Agentic Awakening</p>
        <p>It is a period of manual testing. From a university hostel, a young founder has launched DollarsGPT, rallying 20,000 users to the cause.</p>
        <p>Joining the Infosys and Morgan Stanley fleets, our engineer forges test frameworks, co-invents the BLAZE engine, and brings DevOps to the galaxy, cutting production incidents by 45%.</p>
        <p>For five years the Plumber answers every call, modernizing systems across the fleet and handing each team cookie-cutter tools so no leak returns.</p>
        <p>Now, as the agents rise, Abhinav leads the mission to bring them safely into production. Somewhere in the Glasgow system, the next agent is already being built....</p>
      </div>
    </div>
  </dialog>
  <script type="application/json" data-commands set:html={JSON.stringify(commands).replace(/</g, '\\u003c')} />
</div>

<style>
  .term {
    display: flex; flex-direction: column; min-height: 22rem; max-height: min(36rem, 85vh);
    background: color-mix(in srgb, var(--raised) 92%, transparent);
    border: 1px solid var(--line); font: 0.88rem/1.55 var(--mono);
    backdrop-filter: blur(4px);
  }
  .bar { display: flex; justify-content: space-between; flex-wrap: wrap; align-items: center; gap: 0.25rem 0.75rem; padding: 0.5rem 0.9rem; border-bottom: 1px solid var(--line); color: var(--cyan); font-size: 0.8rem; }
  .out { flex: 1; min-height: 0; overflow-y: auto; padding: 0.9rem; }
  .out :global(p) { margin: 0 0 0.35rem; white-space: pre-wrap; overflow-wrap: anywhere; }
  .out :global(p.r) { margin-bottom: 1rem; }
  .term :global(.p) { color: var(--red); }
  .term :global(.g) { color: var(--cyan); }
  .term :global(.d) { color: var(--muted); }
  .out :global(a) { color: var(--text); }
  .in { display: flex; gap: 0.6ch; padding: 0.2rem 0.9rem 0.6rem; }
  .in[hidden], .chips[hidden] { display: none; }
  .in input { flex: 1; min-width: 0; background: transparent; border: 0; color: var(--text); font: inherit; caret-color: var(--cyan); }
  .in input:focus { outline: none; }
  .in:focus-within { box-shadow: inset 0 -1px 0 var(--cyan); }
  .chips { display: flex; flex-wrap: wrap; gap: 0.4rem; padding: 0.6rem 0.9rem 0.8rem; border-top: 1px solid var(--line); }
  .chips button {
    font: 0.78rem var(--mono); color: var(--text); background: var(--bg); border: 1px solid var(--line);
    padding: 0.25rem 0.7rem; cursor: pointer;
  }
  .chips button:hover { border-color: var(--cyan); color: var(--cyan); }

  /* The crawl is its own scene: fixed colours whatever the site theme. */
  .crawl {
    width: 100vw; height: 100vh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0;
    background: #000; color: #ffe81f; overflow: hidden; font-family: var(--display);
  }
  .crawl::backdrop { background: #000; }
  .skip-crawl {
    position: absolute; top: 1rem; right: 1rem; z-index: 2; font: 500 0.85rem var(--mono); color: #8f98ad;
    background: transparent; border: 1px solid #243049; border-radius: 4px; padding: 0.35rem 0.8rem; cursor: pointer;
  }
  .skip-crawl:hover { color: #ffe81f; border-color: #ffe81f; }
  .crawl-intro {
    position: absolute; inset: 0; display: grid; place-items: center; margin: 0; padding: 0 16px; text-align: center;
    font: 400 clamp(1.1rem, 3vw, 1.8rem) var(--sans); color: #4bd5ee; opacity: 0;
  }
  .crawl-stage { position: absolute; inset: 0; perspective: 360px; display: flex; justify-content: center; }
  .crawl-text {
    width: min(38rem, 88vw); font-size: clamp(1.6rem, 4.4vw, 2.6rem); line-height: 1.35; text-align: justify;
    transform-origin: 50% 100%; transform: rotateX(24deg) translateY(110vh); opacity: 0;
  }
  .crawl-text p { margin: 0 0 1.2em; }
  .crawl-text .ep, .crawl-text .ep-title { text-align: center; margin-bottom: 0.2em; text-transform: uppercase; letter-spacing: 0.04em; }
  .crawl-text .ep-title { font-size: 1.5em; margin-bottom: 1em; }
  .crawl[open].rolling .crawl-intro { animation: intro 5s ease-in-out forwards; }
  .crawl[open].rolling .crawl-text { animation: roll 60s linear 5s forwards; }
  @keyframes intro { 15%, 75% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes roll {
    0% { opacity: 1; transform: rotateX(24deg) translateY(110vh); }
    90% { opacity: 1; }
    100% { opacity: 0; transform: rotateX(24deg) translateY(-260vh); }
  }
  @media (prefers-reduced-motion: reduce) {
    .crawl { overflow-y: auto; }
    .crawl-intro { position: static; opacity: 1; padding-top: 4rem; }
    .crawl-stage { position: static; perspective: none; }
    .crawl-text { transform: none; opacity: 1; padding-block: 2rem 4rem; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-term]');
  if (root) {
    const out = root.querySelector<HTMLElement>('[data-out]')!;
    const form = root.querySelector<HTMLFormElement>('[data-form]')!;
    const input = root.querySelector<HTMLInputElement>('[data-input]')!;
    const chips = root.querySelector<HTMLElement>('[data-chips]')!;
    const commands: Record<string, string> = JSON.parse(root.querySelector('[data-commands]')!.textContent!);
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const crawl = root.querySelector<HTMLDialogElement>('[data-crawl]')!;
    crawl.querySelector('[data-close]')!.addEventListener('click', () => crawl.close());
    crawl.addEventListener('close', () => { crawl.classList.remove('rolling'); input.focus(); });
    let busy = false;

    const line = (html: string) => {
      const p = document.createElement('p');
      p.innerHTML = html;
      out.append(p);
      return p;
    };

    async function run(raw: string, typed: boolean) {
      if (busy) return;
      busy = true;
      const cmd = raw.trim().toLowerCase().replace(/\s+/g, ' ');
      const echo = line('<span class="p">$ </span>');
      const text = document.createTextNode('');
      echo.append(text);
      if (typed && !still) {
        for (const ch of raw) { text.data += ch; await new Promise((r) => setTimeout(r, 32)); }
      } else text.data = raw;

      if (cmd === 'clear') out.replaceChildren();
      else if (commands[cmd]) line(commands[cmd]).className = 'r';
      else {
        const p = line('');
        p.className = 'r d';
        p.textContent = `${raw.trim()}: command not found. Type help.`;
      }
      out.scrollTop = out.scrollHeight;
      busy = false;
      if (cmd === 'pip') dispatchEvent(new Event('pip:summon'));
      if (cmd === 'cv') setTimeout(() => (location.href = '/cv/'), 600);
      if (cmd === 'crawl') {
        crawl.classList.remove('rolling');
        crawl.showModal();
        void crawl.offsetWidth; // restart the animation on every run
        crawl.classList.add('rolling');
      }
    }

    form.hidden = false;
    chips.hidden = false;
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const v = input.value;
      input.value = '';
      if (v.trim()) run(v, false);
    });
    chips.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-cmd]');
      if (b) run(b.dataset.cmd!, true);
    });
  }
</script>
